# ================================================================================================
# 🏗️ PROJECT-SPECIFIC CONFIGURATION (90-project.env)
# ================================================================================================
#
# Purpose: Project-specific overrides for go-overlay-discovery-services
# Load Order: 90 (loaded near-last, overrides all default/tool configurations)
#
# This file contains settings unique to this project that differ from the
# shared defaults in 00-core.env and 10-*.env files.
#
# Override in: 99-local.env (local development only, git-ignored)
#
# ================================================================================================

# ================================================================================================
# 🎯 GO VERSION OVERRIDES
# ================================================================================================

# Primary Go version for builds and primary test runner
GO_PRIMARY_VERSION=1.26.x

# Secondary Go version for compatibility testing
GO_SECONDARY_VERSION=1.26.x

# ================================================================================================
# 🔧 MAGE-X VERSION OVERRIDES
# ================================================================================================

MAGE_X_GO_VERSION=1.26.x
MAGE_X_GO_SECONDARY_VERSION=1.26.x

# ================================================================================================
# 📊 COVERAGE PROVIDER OVERRIDES
# ================================================================================================

# Coverage Provider Selection (this project uses codecov)
GO_COVERAGE_PROVIDER=codecov

# Codecov Configuration
CODECOV_TOKEN_REQUIRED=true

# Coverage Exclusions (matches codecov.yml ignore paths)
GO_COVERAGE_EXCLUDE_PATHS=.github/,.mage-cache/,.vscode/,bin/,example/,examples/,mocks/,testing/,test/,vendor/,testdata/

# ================================================================================================
# 🛡️ SECURITY SCANNER EXCLUSIONS
# ================================================================================================

# CVE-2026-26014 for github.com/pion/dtls/v2@v2.2.12
# Information Exposure (CWE-200) - Random nonce generation with GCM ciphers
# Affects: pion/dtls/v2 v1.0.0 through v2.2.12 (v2.2.12 is latest in v2 branch)
# Fixed in: pion/dtls/v3@v3.1.0+ (we have v3.1.1, which is safe)
# Dependency path: go-overlay-discovery-services → go-libp2p@v0.47.0 → pion/webrtc/v4 → pion/dtls/v2
# Status: Transitive dependency - cannot upgrade v2→v3 (different major versions)
# Mitigation: v3.1.1 is already present for WebRTC functionality
# Risk: Low - vulnerability in legacy v2 branch, safe v3 branch in use
# Monitoring: Track go-libp2p releases for removal of v2 dependency

# CVEs for github.com/containerd/containerd/v2@v2.2.4 (transitive, unreachable)
# CVE-2026-53488 (8.7) CRI plugin label propagation host command execution
# CVE-2026-53492 (8.4) Improper trust of CDI annotations in checkpoint restore
# CVE-2026-47262 (7.1) Malicious image causes memory exhaustion DoS
# CVE-2026-53489 (6.8) Symlink path validation bypass in checkpoint restore
# CVE-2026-50195 (5.0) Checkpoint image reference validation bypass
# `go mod why` reports "main module does not need package" - containerd is a deep
# transitive dependency (build tooling), never imported by production code paths.
#
# CVEs for golang.org/x/image@v0.25.0 (transitive, unreachable)
# CVE-2026-46601 (8.7) WebP decoder panic on mismatched VP8 chunk dimensions
# CVE-2026-46602 (8.7) TIFF decoder unbounded memory on large tiles
# CVE-2026-46604 (7.5) TIFF decoder panic on out-of-bounds strip offset
# `go mod why` reports "main module does not need package" - pulled only by the
# gonum/plot benchmark/plotting tooling, never imported by production code paths.
#
# CVEs for github.com/moby/buildkit@v0.29.0 (transitive, unreachable)
# CVE-2026-15789 (6.9) Path traversal in BuildKit daemon upload request handling
# CVE-2026-15792 (6.3) Improper input validation on crafted client/frontend request
# CVE-2026-15788 (5.6) Link following via cache mount source= selector (Windows)
# CVE-2026-15791 (1.8) Path traversal via crafted low-level build API message
# `go mod why` reports "main module does not need module" - container build tooling,
# never imported by production code paths.
#
# CVEs for github.com/gofiber/fiber/v2@v2.52.12 (transitive, unreachable)
# CVE-2026-45045 (5.3) Authentication bypass by spoofing (fixed in fiber v3.3.0)
# CVE-2026-53624 (4.8) Cleartext transmission of sensitive information (fixed in v3.4.0)
# `go mod why` reports "main module does not need module" - this project does not use
# fiber; no fix exists in the v2 branch (v2→v3 is a major version bump).
#
# CVE-2026-54908 for github.com/pion/dtls/v2@v2.2.12 (transitive, unreachable)
# Out-of-bounds read (CWE-125) - same v2-branch situation as CVE-2026-26014 above.
# Fixed in pion/dtls/v3; v3.1.1 is already present for WebRTC functionality.
#
# CVE-2026-49834 for github.com/sigstore/sigstore-go@v1.1.4 (transitive, unreachable)
# Improper verification of cryptographic signature (CWE-347)
# `go mod why` reports "main module does not need module" - artifact signing/verification
# tooling, never imported by production code paths.
#
# CVE-2026-54787 for github.com/sigstore/sigstore-go@v1.1.4 (transitive, unreachable)
# CWE-324: Use of a key past its expiration date - fixed in v1.2.1
# `go mod why` reports "main module does not need package" - same unreachable
# artifact signing/verification tooling as CVE-2026-49834 above.
#
# CVE-2026-54909 for github.com/pion/stun@v0.6.1 (transitive, unreachable)
# CWE-20: Improper Input Validation - XORMappedAddress.GetFromAs panic on malformed
# STUN/ICE attribute, fixed in v3.1.3. `go mod why` reports "main module does not
# need package" for the unversioned github.com/pion/stun module; this project uses
# github.com/pion/stun/v3@v3.1.6 (already past the fixed version) for WebRTC.

# Nancy Security Scanner Exclusions (comma-separated CVE IDs)
NANCY_EXCLUDES=CVE-2024-38513,CVE-2023-45142,CVE-2025-11065,CVE-2026-26014,CVE-2025-15558,CVE-2026-33747,CVE-2026-33748,CVE-2026-33809,CVE-2026-34986,CVE-2026-33815,CVE-2026-33816,CVE-2026-39882,CVE-2026-39883,CVE-2026-5160,CVE-2026-35469,CVE-2026-33813,CVE-2026-33812,CVE-2026-42554,CVE-2026-46599,CVE-2026-42500,CVE-2026-53488,CVE-2026-53492,CVE-2026-47262,CVE-2026-53489,CVE-2026-50195,CVE-2026-46601,CVE-2026-46602,CVE-2026-46604,CVE-2026-15789,CVE-2026-15792,CVE-2026-15788,CVE-2026-15791,CVE-2026-45045,CVE-2026-53624,CVE-2026-54908,CVE-2026-49834,CVE-2026-54787,CVE-2026-54909

# Govulncheck/Magex CVE Exclusions
# CVE-2023-26248 (GO-2024-3218): libp2p-kad-dht content censorship via DHT abuse
# No fix available upstream; low risk for this application's use case
MAGE_X_CVE_EXCLUDES=CVE-2023-26248,CVE-2026-26014,CVE-2025-15558,CVE-2026-33747,CVE-2026-33748,CVE-2026-33809,CVE-2026-34986,CVE-2026-33815,CVE-2026-33816,CVE-2026-5160,CVE-2026-35469,CVE-2026-33813,CVE-2026-33812,CVE-2026-42554,CVE-2026-46599,CVE-2026-42500,GO-2026-5932

# ================================================================================================
# ⚙️ BUILD CONFIGURATION
# ================================================================================================

# Disable cache warming pre-build - this repo's packages have 1750+ dependencies
# (due to go-sdk wallet and go-overlay-services imports) which causes OOM kills
# even with batch size 1 and parallelism 1 on GitHub Actions runners.
# Module cache still works; only build cache warming is disabled.
#ENABLE_CACHE_WARMING=false

# Skip Mage-X build steps that are not needed for this project to reduce build time and resource usage.
MAGE_X_BUILD_STRATEGY=skip
